<mvc:View controllerName="com.pontual.sgmr.controller.Administrativo"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc" 
    displayBlock="true"
    xmlns="sap.m">
    <Page id="pageInicio" 
          title="{i18n>title}" 
          titleAlignment="Center"
          showNavButton="true" 
          navButtonPress="onNavBack"         
          class="sapUiContentPadding sapUiResponsivePadding--header sapUiResponsivePadding--subHeader sapUiResponsivePadding--content sapUiResponsivePadding--footer">
        <headerContent>
        <Button
				tooltip="{i18n>sincronizar}"
				icon="sap-icon://synchronize"
				press="onSincronizar"
                type="Neutral"/>	
            <ObjectStatus
                id="networkStatus"
                active="false"
                inverted="true"
                icon="{path: 'conexaoModel>statusConexao',
                    formatter: 'com.pontual.sgmr.model.formatter.getIconeConexao'}"
                state="{path: 'conexaoModel>statusConexao',
                        formatter: 'com.pontual.sgmr.model.formatter.getCorIconeConexao'}"
            />
        </headerContent>            
		<content>
            <VBox fitContainer="true" justifyContent="Center" alignItems="Center" alignContent="Center">
                <items>                    
                <Button id="entrarPerfilButton" width="12rem" text="{i18n>perfil}" type="Default" press="onEntrarPerfil" icon="sap-icon://business-card" class="sapUiSmallMarginBottom" visible="{acessosModel>perfil}" />
                <Button id="entrarUsuarioButton" width="12rem" text="{i18n>usuario}" type="Default" press="onEntrarUsuario" icon="sap-icon://person-placeholder" class="sapUiSmallMarginBottom" visible="{acessosModel>usuario}" />
                <!-- <Button id="associarButton" width="12rem" text="{i18n>associarformulariotitle}" type="Emphasized" press="onAssociarFormulario" icon="sap-icon://form" class="sapUiSmallMarginBottom" visible="{acessosModel>associar}"></Button>   -->                                      
                <!-- <Button id="sincronismoButton" width="12rem" text="Sincronizar" type="Emphasized" press="onSincronizar" icon="sap-icon://synchronize" class="sapUiSmallMarginBottom" visible="{acessosModel>sincronizar}"></Button>   -->                                              
                </items>
            </VBox>
		</content>
		<footer>
			<OverflowToolbar>
                <Button
                    id="messagePopoverBtn"
                    visible="{=!!${mMensagens>/}.length > 0}"
                    icon="{ path: 'mMensagens>/', formatter: '.buttonIconFormatter' }"
                    type="{ path: 'mMensagens>/', formatter: '.buttonTypeFormatter' }"
                    text="{= (${mMensagens>/}.length === 1) ? ${mMensagens>/}[0].title : ${mMensagens>/}.length }"
                    press=".exibeMensagens"
                    ariaHasPopup="Dialog"
                />
				<ToolbarSpacer/>
			</OverflowToolbar>
		</footer>
    </Page>
</mvc:View>
