<mvc:View
	controllerName="com.pontual.sgmr.controller.Formulario"  
    height="100%"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"   
    displayBlock="true"
    xmlns="sap.m">

		    <VBox class="sapUiSmallMargin">     
				<f:Form id="idFormRoletes"
				editable="false">
				<f:layout>
					<f:ResponsiveGridLayout
						labelSpanXL="4"
						labelSpanL="4"
						labelSpanM="12"
						labelSpanS="12"
						adjustLabelSpan="false"
						emptySpanXL="0"
						emptySpanL="0"
						emptySpanM="0"
						emptySpanS="0"
						columnsXL="2"
						columnsL="2"
						columnsM="2"
						singleContainerFullSize="false" />
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Roletes com Vazamentos" >
								<f:fields>
									<ObjectStatus class="sapMObjectStatusMedium" text="{= ${materialRodanteFormularioModel>RoleteVazamento} ? 'Sim' : 'Não' }" inverted="true" state="{= ${materialRodanteFormularioModel>RoleteVazamento} ? 'Indication03' : 'Indication05' }"/>

									<!-- <Switch state="{materialRodanteFormularioModel>RoleteVazamento}" customTextOn="{i18n>sim}" customTextOff="{i18n>nao}" change="atualizaTotalRoletes" >
										<layoutData>
											<FlexItemData growFactor="1" />
										</layoutData>
									</Switch>				 -->
								</f:fields>
							</f:FormElement>    							
							<f:FormElement label="Qtde Lado Direito">
								<f:fields>							
		                            <StepInput id="inputRoletesVazandoLD" value="{materialRodanteFormularioModel>RoleteQtdeLD}" displayValuePrecision="0" step="1" min="0" max="{materialRodanteFormularioModel>MaxRoleteQtdeLD}" editable="true" change="controlaIndicadorVazamento"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label=" Qtde Lado Esquerdo">
								<f:fields>							
		                            <StepInput id="inputRoletesVazandoLE" value="{materialRodanteFormularioModel>RoleteQtdeLE}" displayValuePrecision="0" step="1" min="0" max="{materialRodanteFormularioModel>MaxRoleteQtdeLE}" editable="true" change="controlaIndicadorVazamento"/>
								</f:fields>
							</f:FormElement>                                                                                      
						</f:formElements>
					</f:FormContainer>																
				</f:formContainers>				
			</f:Form>     
		</VBox>
</mvc:View>
