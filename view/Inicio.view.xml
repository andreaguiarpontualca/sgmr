<mvc:View
    controllerName="com.pontual.sgmr.controller.Inicio"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
>
    <Page
        id="pageMenuInicio"
        title="{i18n>title}"
        titleAlignment="Center"
        showNavButton="false"
        showSubHeader="true"
        navButtonText="Sair"
        icon="sap-icon://visits"
        navButtonPress="onNavBack"
        class="sapUiSizeCozy sapUiContentPadding sapUiResponsivePadding--header sapUiResponsivePadding--subHeader sapUiResponsivePadding--content sapUiResponsivePadding--footer"
    >
        <headerContent>
            <Button
                tooltip="{i18n>sair}"
                icon="sap-icon://log"
                press="onSairApp"
                type="Transparent"
            />
            <ObjectStatus
                id="networkStatus"
                active="false"
                inverted="true"
                icon="{path: 'conexaoModel>statusConexao', formatter: 'com.pontual.sgmr.model.formatter.getIconeConexao'}"
                state="{path: 'conexaoModel>statusConexao', formatter: 'com.pontual.sgmr.model.formatter.getCorIconeConexao'}"
            />
        </headerContent>
        <content>
            <HBox
                alignContent="Center"
                alignItems="Center"
                justifyContent="Center"
            >
                <Title
                    text="Bem-vindo {usuarioModel>CodUsuario}"
                    level="H3"
                />
            </HBox>
            <VBox
                id="inicioFormContainer"
                fitContainer="true"
                justifyContent="Center"
                alignItems="Center"
                alignContent="Center"
            >
                <items>
                    <Button id="entrarMaterialRodanteButton" width="12rem" text="{i18n>inspecionar}"    type="Default" press="onEntrarMaterialRodante" icon="sap-icon://inspection"  visible="{acessosModel>materialrodante}" />
                    <Button id="entrarAdministrativoButton"  width="12rem" text="{i18n>administrativo}" type="Default" press="onEntrarAdministrativo"  icon="sap-icon://account"     visible="{acessosModel>administrativo}" class="sapUiSmallMarginBottom"/>
                    <Button id="inicioSincronismoButton"     width="12rem" text="Sincronizar"           type="Neutral" press="onSincronizar"           icon="sap-icon://synchronize" visible="true" class="sapUiSmallMarginBottom"/>
                </items>
            </VBox>
        </content>
        <footer>
            <OverflowToolbar>
                <Button
                    id="messagePopoverBtn"
                    visible="{=!!${message>/}.length}"
                    icon="{ path: '/', formatter: '.buttonIconFormatter' }"
                    type="{ path: '/', formatter: '.buttonTypeFormatter' }"
                    text="{path: '/', formatter: '.highestSeverityMessages' }"
                    press=".handleMessagePopoverPress"
                    ariaHasPopup="Dialog"
                />
                <ToolbarSpacer />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
